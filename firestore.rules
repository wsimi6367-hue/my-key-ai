rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque utilisateur ne peut lire et modifier que sa propre fiche.
    match /users/{uid} {
      // Suppression permise au titulaire (bouton « Supprimer mon compte »).
      allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;

      // Ses conversations : lecture, écriture et suppression par lui seul.
      match /conversations/{convId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
